# Copy this file to ".env.local" (on your computer) or add these in
# Vercel → Project → Settings → Environment Variables.
# If none are set, the inquiry form still works in "test mode":
# messages are printed in the server log instead of being sent.

# --- Email (via https://resend.com, free tier) ---
RESEND_API_KEY=
# Where inquiries are delivered (the family's inbox)
INQUIRY_TO_EMAIL=
# Sender address. Use "onboarding@resend.dev" until you verify your own domain.
INQUIRY_FROM_EMAIL=L2 Angkor Website <onboarding@resend.dev>

# --- Telegram notification (create a bot with @BotFather) ---
TELEGRAM_BOT_TOKEN=
# Your personal or group chat ID (message @userinfobot to find it)
TELEGRAM_CHAT_ID=
