# Copy this file to ".env.local" (on your computer) or add these in
# Vercel → Project → Settings → Environment Variables.
# Everything here is optional: the site works without them.

# --- Enquiry form: email (via https://resend.com, free tier) ---
# Without email or Telegram set up, the form runs in "test mode" and
# messages only appear in the server log.
RESEND_API_KEY=
# Where enquiries are delivered (the family's inbox)
INQUIRY_TO_EMAIL=
# Sender address. Use "onboarding@resend.dev" until you verify your own domain.
INQUIRY_FROM_EMAIL=L2 Angkor Website <onboarding@resend.dev>

# --- Enquiry form: Telegram notification (create a bot with @BotFather) ---
TELEGRAM_BOT_TOKEN=
# Your personal or group chat ID (message @userinfobot to find it)
TELEGRAM_CHAT_ID=

# --- Instant updates from the admin ---
# Any long random text. Use the same value as the "Secret" of the Sanity webhook
# that calls https://<your-site>/api/revalidate (see EDITING.md).
SANITY_REVALIDATE_SECRET=
